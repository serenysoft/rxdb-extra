{
  "name": "rxdb-extra",
  "description": "Extra Plugins for RxDB",
  "readmeFilename": "README.md",
  "version": "0.2.1",
  "license": "MIT",
  "keywords": [
    "javascript",
    "nodejs",
    "rxdb",
    "search",
    "searchable",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/serenysoft/rxdb-extra"
  },
  "bugs": {
    "url": "https://github.com/serenysoft/rxdb-extra/issues"
  },
  "author": {
    "name": "Leandro Guindani Gehlen",
    "email": "leandrogehlen@gmail.com"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rimraf -rf dist/ && tsc --project tsconfig.dist.json",
    "lint": "eslint \"src/**/*\" \"tests/**/*\"",
    "release": "release-it --only-version",
    "test": "cross-env NODE_ENV=test jest --verbose --runInBand --detectOpenHandles",
    "test:ci": "cross-env NODE_ENV=test jest --verbose --collect-coverage --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch"
  },
  "engines": {
    "node": ">= 20"
  },
  "peerDependencies": {
    "rxdb": "^15.0.0 || ^16.0.0 || ^17.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@faker-js/faker": "^10.4.0",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.2",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "Release v${version}",
      "requireCleanWorkingDir": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "npm run build"
      ]
    }
  }
}
